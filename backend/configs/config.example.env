# Server Monitor agent configuration
HTTP_ADDR=:9191
SERVER_ID=web-01
API_TOKEN=
CORS_ORIGINS=*
METRICS_INTERVAL=1s
HISTORY_SIZE=60
LOG_LEVEL=info

# Optional webhook alerting: posts CPU/memory alerts to a webhook, e.g. an n8n
# workflow that screenshots CAPTURE_URL and forwards it to Telegram/WhatsApp.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_CHANNEL=both
WEBHOOK_CHAT_ID=
WEBHOOK_WA_RECIPIENT=
CAPTURE_URL=http://localhost:8080/
