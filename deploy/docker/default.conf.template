# Nginx configuration for the dashboard container.
#
# Rendered by the official image's entrypoint: each placeholder that matches a
# real environment variable is substituted at startup. Nginx's own runtime
# variables ($host, $remote_addr, $http_upgrade, ...) are left untouched,
# because the entrypoint passes envsubst an explicit list of defined variables
# rather than letting it rewrite every dollar sign it finds.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Compression matters here: the ECharts chunk is ~500 KB raw and ~169 KB
    # gzipped, which is the difference between an instant and a sluggish first
    # paint on a wall display.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # -----------------------------------------------------------------------
    # Device photos.
    #
    # Declared before the catch-all so it wins. These filenames never change
    # when their contents do, unlike the hashed JS/CSS bundles, so the
    # immutable one-year policy below must not apply to them — it would pin a
    # replaced photo on the display for a year.
    # -----------------------------------------------------------------------
    location /images/ {
        root /usr/share/nginx/html;
        expires 10m;
        add_header Cache-Control "public, must-revalidate";
    }

    # Server registry: read on every page load, must never be stale.
    location = /servers.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # -----------------------------------------------------------------------
    # Static frontend
    # -----------------------------------------------------------------------
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Safe to cache hard: Vite fingerprints these filenames.
        location ~* \.(js|css|woff|woff2|ttf|eot|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # =======================================================================
    # Agent proxies — one API pair and one WebSocket pair per monitored node.
    # Addresses come from .env so an IP change needs a restart, not a rebuild.
    # =======================================================================

    # --- 1. Web Server 01 -----------------------------------------------
    location /servers/web01/api/ {
        proxy_pass http://${SRV_WEB01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/web01/ws/ {
        proxy_pass http://${SRV_WEB01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- 2. Application Server ------------------------------------------
    location /servers/app01/api/ {
        proxy_pass http://${SRV_APP01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/app01/ws/ {
        proxy_pass http://${SRV_APP01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- 3. Database Server ---------------------------------------------
    location /servers/db01/api/ {
        proxy_pass http://${SRV_DB01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/db01/ws/ {
        proxy_pass http://${SRV_DB01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- 4. Monitoring Server -------------------------------------------
    location /servers/monitor01/api/ {
        proxy_pass http://${SRV_MONITOR01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/monitor01/ws/ {
        proxy_pass http://${SRV_MONITOR01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- 5. Reverse Proxy -----------------------------------------------
    location /servers/proxy01/api/ {
        proxy_pass http://${SRV_PROXY01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/proxy01/ws/ {
        proxy_pass http://${SRV_PROXY01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- 6. Edge Server -------------------------------------------------
    location /servers/edge01/api/ {
        proxy_pass http://${SRV_EDGE01}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location /servers/edge01/ws/ {
        proxy_pass http://${SRV_EDGE01}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- Prometheus Proxy for Historical Metrics & SLA -------------------
    location /prometheus/api/ {
        proxy_pass http://${PROMETHEUS_ADDR}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
