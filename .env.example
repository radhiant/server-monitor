# Copy to .env and adjust:
#   cp .env.example .env

# Port the dashboard is published on: http://<server>:<FRONTEND_PORT>
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Agent address on each monitored machine (host:port). The agent runs as a
# systemd service on every node, on port 9191.
#
# An address change only needs `docker compose up -d`, not a rebuild.
# Adding a node takes three edits:
#   1. an entry in frontend/public/servers.json
#   2. a location pair in deploy/docker/default.conf.template
#   3. a variable here and in docker-compose.yml
# ---------------------------------------------------------------------------
SRV_WEB01=192.0.2.11:9191
SRV_APP01=192.0.2.12:9191
SRV_DB01=192.0.2.13:9191
SRV_MONITOR01=192.0.2.14:9191
SRV_PROXY01=192.0.2.15:9191
SRV_EDGE01=198.51.100.20:9191

# Prometheus, for the SLA and history charts.
PROMETHEUS_ADDR=prometheus:9090

# Container time zone (Nginx logs only; the dashboard clock follows the browser).
TZ=Asia/Jakarta
