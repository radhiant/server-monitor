# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
# 178 MB, and the native binaries inside it are platform-specific: the Windows
# build of esbuild/rollup would break any Linux checkout. package-lock.json is
# what makes installs reproducible, so that one stays tracked.
node_modules/
.npm/
.pnpm-store/


# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Regenerated by `npm run build` and by the Docker image build.
dist/
frontend/dist/

# Compiled Go agent binaries.
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out


# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
# Real .env files hold agent addresses and, if enabled, API_TOKEN. Only the
# templates belong in the repository.
.env
.env.*
*.env
!.env.example
!*.example.env
!frontend/.env.example
!backend/configs/config.example.env


# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini


# ---------------------------------------------------------------------------
# Logs & temporary files
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
tmp/
*.tar.gz


# ---------------------------------------------------------------------------
# Test & tooling artefacts
# ---------------------------------------------------------------------------
coverage/
*.coverprofile
.vite/
.cache/


# ---------------------------------------------------------------------------
# Device photos
# ---------------------------------------------------------------------------
# Left tracked on purpose: the Docker build copies them into the image, so a
# fresh checkout deploys with the right pictures. Uncomment the two lines below
# if this repository is public and photographs of the server room should not be.
# frontend/public/images/*
# !frontend/public/images/README.md

# Agent binaries built in place
backend/server-monitor
backend/server-monitor-32bit
